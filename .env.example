# demo | fal | kie | ark | auto
# auto: human face → kie; no face → ark (requires both keys); unknown → kie
VIDEO_PROVIDER=demo

# FAL
FAL_KEY=
FAL_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video
FAL_RESOLUTION=480p

# KIE
KIE_API_KEY=
KIE_API_BASE=https://api.kie.ai
# cheaper: bytedance/seedance-2-mini | quality: bytedance/seedance-2-5
KIE_VIDEO_MODEL=bytedance/seedance-2-mini
KIE_RESOLUTION=480p

# Volcengine Ark (豆包 Seedance) — https://ark.cn-beijing.volces.com
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# ARK_GENERATE_AUDIO=true
# ARK_WATERMARK=false

# Public site URL used in Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (stripe listen --forward-to localhost:3005/api/webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage: local uses data/kv/*.json automatically.
# On Cloudflare (OpenNext), bind a KV namespace named DUETBOOTH_KV in wrangler.toml.

# Auth.js / Google Sign-In
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional override (defaults to NEXT_PUBLIC_APP_URL / request host)
# AUTH_URL=http://localhost:3005
